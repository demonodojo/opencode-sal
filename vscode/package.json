{
  "name": "supercoder",
  "displayName": "SuperCoder",
  "description": "Agente de código supercoder (supercoder-sal) en VS Code: herramientas, permisos, subagentes e imágenes, con soso-llm o claude -p.",
  "version": "0.5.0",
  "publisher": "demonodojo",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "supercoder",
          "title": "SuperCoder",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "supercoder": [
        {
          "type": "webview",
          "id": "supercoder.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "supercoder.openChat",
        "title": "SuperCoder: Abrir chat"
      },
      {
        "command": "supercoder.newChat",
        "title": "SuperCoder: Nuevo chat"
      },
      {
        "command": "supercoder.selectModel",
        "title": "SuperCoder: Elegir modelo"
      },
      {
        "command": "supercoder.sendSelection",
        "title": "SuperCoder: Enviar selección al chat"
      },
      {
        "command": "supercoder.stop",
        "title": "SuperCoder: Detener"
      },
      {
        "command": "supercoder.attachFiles",
        "title": "SuperCoder: Adjuntar ficheros"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "supercoder.sendSelection",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "SuperCoder",
      "properties": {
        "supercoder.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Ruta del binario supercoder. Vacío: out/linux/bin/supercoder del workspace si existe; si no, 'supercoder' del PATH."
        },
        "supercoder.model": {
          "type": "string",
          "default": "",
          "description": "Modelo por defecto (--model). Vacío: el de supercoder.json o soso-coder. Usa 'claude:<alias>' para claude -p."
        },
        "supercoder.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "claude:sonnet",
            "claude:opus",
            "claude:haiku"
          ],
          "description": "Modelos adicionales ofrecidos en el selector (además de los de 'models' en supercoder.json)."
        },
        "supercoder.maxTurns": {
          "type": "number",
          "default": 60,
          "description": "Máximo de vueltas del bucle de herramientas (--max-turns)."
        },
        "supercoder.historyTurns": {
          "type": "number",
          "default": 6,
          "description": "Intercambios previos que se reenvían como contexto en el participante @supercoder (el panel usa una sesión de supercoder)."
        },
        "supercoder.autoApprove": {
          "type": "boolean",
          "default": false,
          "description": "Aprobar sin preguntar las herramientas que piden permiso (--yes). Si está desactivado se pregunta en el panel o en un cuadro modal."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "supercoder.agent",
        "name": "supercoder",
        "fullName": "SuperCoder",
        "description": "Agente de código supercoder-sal (soso-llm o claude -p)",
        "isSticky": true,
        "commands": [
          {
            "name": "model",
            "description": "Elegir modelo (/model <nombre>, /model default, o sin argumento para el selector)"
          }
        ]
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "supercoder",
        "displayName": "SuperCoder"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
