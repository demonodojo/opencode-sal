import "../../src/provider/openai.sal"
import "../../src/agent/messages.sal"
import "../../src/config.sal"
import "support/assert.sal"

fn main() -> Int ! io, alloc
    f = 0
    ok = "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"hola\",\"tool_calls\":[{\"id\":\"call_7\",\"type\":\"function\",\"function\":{\"name\":\"read\",\"arguments\":\"{\\\"filePath\\\":\\\"/tmp/x\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":11,\"completion_tokens\":3,\"total_tokens\":14}}"
    r = oai_parse(200, &ok)
    f = f + ck_int(pr_ok(&r), 1, 1)
    f = f + ck_str(&pr_text(&r), &"hola", 2)
    f = f + ck_int(pr_calls(&r).len(), 1, 3)
    call = pr_calls(&r).get(0)
    f = f + ck_str(&call_id(&call), &"call_7", 4)
    f = f + ck_str(&call_name(&call), &"read", 5)
    f = f + ck_str(&call_args(&call), &"{\"filePath\":\"/tmp/x\"}", 6)
    f = f + ck_int(pr_in(&r), 11, 7)
    f = f + ck_int(pr_out(&r), 3, 8)
    f = f + ck_str(&pr_finish(&r), &"tool_calls", 9)

    txt = "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"solo texto\"},\"finish_reason\":\"stop\"}]}"
    r2 = oai_parse(200, &txt)
    f = f + ck_int(pr_calls(&r2).len(), 0, 10)
    f = f + ck_str(&pr_text(&r2), &"solo texto", 11)

    obj = "{\"choices\":[{\"message\":{\"content\":null,\"tool_calls\":[{\"function\":{\"name\":\"bash\",\"arguments\":{\"command\":\"ls\"}}}]}}]}"
    r3 = oai_parse(200, &obj)
    f = f + ck_str(&call_args(pr_calls(&r3).get(0)), &"{\"command\":\"ls\"}", 12)
    f = f + ck_str(&call_id(pr_calls(&r3).get(0)), &"call_1", 13)

    e = oai_parse(400, &"{\"error\":{\"message\":\"bad things\"}}")
    f = f + ck_int(pr_ok(&e), 0, 14)
    f = f + ck_str(&pr_error(&e), &"bad things", 15)
    f = f + ck_int(pr_status(&e), 400, 16)
    e2 = oai_parse(500, &"plain failure")
    f = f + ck_str(&pr_error(&e2), &"plain failure", 17)
    e3 = oai_parse(200, &"not json")
    f = f + ck_int(pr_ok(&e3), 0, 18)

    cf = cfg_load()
    f = f + ck_str(&cfg_provider(&cf, &"ollama:qwen:7b"), &"ollama", 30)
    f = f + ck_str(&cfg_provider(&cf, &"soso-coder"), &"openai", 31)
    f = f + ck_str(&cfg_wire_model(&cf, &"ollama:qwen:7b"), &"qwen:7b", 32)
    f = f + ck_str(&cfg_wire_model(&cf, &"soso-coder"), &"soso-coder", 33)
    f = f + ck_str(&cfg_token(&cf, &"ollama:qwen:7b"), &"", 34)
    f = f + ck_str(&cfg_provider(&cf, &"lmstudio:qwen/qwen3-coder"), &"lmstudio", 35)
    f = f + ck_str(&cfg_wire_model(&cf, &"lmstudio:qwen/qwen3-coder"), &"qwen/qwen3-coder", 36)
    f = f + ck_str(&cfg_token(&cf, &"lmstudio:x"), &"", 37)
    f = f + ck_int(cfg_is_local(&cf, &"lmstudio:x"), 1, 38)

    f = f + ck_str(&msg_user(&"hi \"there\""), &"{\"role\":\"user\",\"content\":\"hi \\\"there\\\"\"}", 20)
    f = f + ck_str(&msg_tool(&"call_1", &"out"), &"{\"role\":\"tool\",\"tool_call_id\":\"call_1\",\"content\":\"out\"}", 21)
    calls = List.new[Call]()
    x = calls.push(call_new(&"call_1", &"read", &"{\"filePath\":\"a\"}"))
    am = msg_assistant(&"", &calls)
    f = f + ck_str(&am, &"{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"call_1\",\"type\":\"function\",\"function\":{\"name\":\"read\",\"arguments\":\"{\\\"filePath\\\":\\\"a\\\"}\"}}]}", 22)
    f = f + ck_str(&msg_assistant(&"t", &List.new[Call]()), &"{\"role\":\"assistant\",\"content\":\"t\"}", 23)

    streamed = StreamCalls(List.new[StreamCall]())
    delta1 = json_parse(&"{\"function\":{\"name\":\"read\",\"arguments\":\"{\\\"path\\\":\"}}")
    delta2 = json_parse(&"{\"id\":\"call_custom\",\"function\":{\"arguments\":\"\\\"a\\\"}\"}}")
    delta3 = json_parse(&"{\"function\":{\"name\":\"list\"}}")
    x = streamed.add_delta(2, &delta1, json_root(&delta1))
    x = streamed.add_delta(0, &delta3, json_root(&delta3))
    x = streamed.add_delta(2, &delta2, json_root(&delta2))
    done = streamed.finish()
    f = f + ck_int(done.len(), 2, 40)
    f = f + ck_str(&call_id(done.get(0)), &"call_1", 41)
    f = f + ck_str(&call_args(done.get(0)), &"{}", 42)
    f = f + ck_str(&call_id(done.get(1)), &"call_custom", 43)
    f = f + ck_str(&call_args(done.get(1)), &"{\"path\":\"a\"}", 44)
    f
