import "../../src/util.sal"
import "../../src/config.sal"
import "../../src/session.sal"
import "../../src/events.sal"
import "support/assert.sal"

fn main() -> Int ! io, alloc
    f = 0
    f = f + ck_str(&path_norm(&"/a/b/../c//./d"), &"/a/c/d", 1)
    f = f + ck_str(&path_norm(&"a/../../b"), &"../b", 2)
    f = f + ck_str(&path_norm(&"/.."), &"/", 3)
    f = f + ck_str(&path_norm(&"./x"), &"x", 4)
    f = f + ck_str(&path_norm(&"."), &".", 5)
    f = f + ck_str(&path_rel(&"/a/b", &"/a/b/c/d.txt"), &"c/d.txt", 6)
    f = f + ck_str(&path_rel(&"/a/b", &"/a/bc/d"), &"/a/bc/d", 7)
    f = f + ck_str(&date_from_secs(0), &"1970-01-01", 8)
    f = f + ck_str(&date_from_secs(1709164800), &"2024-02-29", 9)
    f = f + ck_str(&date_from_secs(1798675200), &"2026-12-31", 10)
    f = f + ck_str(&date_from_secs(1767225600), &"2026-01-01", 11)
    s = Session(d"test-session")
    f = f + ck_str(&s.file(&"messages.json"), &session_file(&"test-session", &"messages.json"), 12)
    ctx = ctx_new()
    x = ctx_add_tokens(&mut ctx, 3, 5)
    x = ctx_add_tokens(&mut ctx, 7, 11)
    f = f + ck_int(ctx_in_tokens(&ctx), 10, 13)
    f = f + ck_int(ctx_out_tokens(&ctx), 16, 14)
    f = f + ck_str(&ev_hide_tags(&"hola <tool_call>\n<function=read>\n<parameter=path>\nsrc\n</parameter>\n</function>\n</tool_call>!"), &"hola !", 15)
    f = f + ck_str(&ev_hide_tags(&"a </parameter> b"), &"a  b", 16)
    f = f + ck_str(&ev_hide_tags(&"hola <file> x"), &"hola <file> x", 17)
    f = f + ck_str(&ev_think_style(&"antes </think>después"), &"antes después", 18)
    f
