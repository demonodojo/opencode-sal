import "../../src/strutil.sal"
import "support/assert.sal"

fn main() -> Int ! io, alloc
    marker = "path" + char_to_str(34) + ":" + char_to_str(34)
    body = "pre " + marker + "/tmp/x.txt" + char_to_str(34) + " tail"
    p = assert_str_eq(extract_quoted_after(body, marker), "/tmp/x.txt", 1)
    if p != 0
        p
    else
        miss = "missing" + char_to_str(34) + ":" + char_to_str(34)
        e = assert_str_eq(extract_quoted_after(body, miss), "", 2)
        if e != 0
            e
        else
            0
