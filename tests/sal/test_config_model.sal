import "../../src/config.sal"
import "../../src/strutil.sal"
import "support/assert.sal"

fn main() -> Int ! io, alloc
    q = char_to_str(34)
    compact = json_lbrace() + q + "model" + q + ":" + q + "claude-x" + q + json_rbrace()
    spaced = json_lbrace() + q + "model" + q + ": " + q + "gpt-y" + q + json_rbrace()
    a = assert_str_eq(config_model_json(compact), "claude-x", 1)
    if a != 0
        a
    else
        b = assert_str_eq(config_model_json(spaced), "gpt-y", 2)
        if b != 0
            b
        else
            c = assert_str_eq(config_model_json(json_lbrace() + json_rbrace()), "", 3)
            if c != 0
                c
            else
                d = assert_str_eq(config_model_for("flag-z"), "flag-z", 4)
                if d != 0
                    d
                else
                    cfg = json_lbrace() + q + "model" + q + ":" + q + "a" + q + "," + q + "models" + q + ":" + json_lbrace() + q + "a" + q + ":" + json_lbrace() + q + "port" + q + ": 7500" + json_rbrace() + "," + q + "b" + q + ":" + json_lbrace() + q + "port" + q + ":7600" + json_rbrace() + "," + q + "c" + q + ":" + json_lbrace() + json_rbrace() + json_rbrace() + json_rbrace()
                    e = assert_zero(config_port_from(cfg, "a") - 7500, 5)
                    if e != 0
                        e
                    else
                        f = assert_zero(config_port_from(cfg, "b") - 7600, 6)
                        if f != 0
                            f
                        else
                            g = assert_zero(config_port_from(cfg, "c") - 7422, 7)
                            if g != 0
                                g
                            else
                                h = assert_zero(config_port_from(cfg, "zzz") - 7422, 8)
                                if h != 0
                                    h
                                else
                                    i = assert_zero(config_port_from(json_lbrace() + q + "x" + q + ":" + q + ":7442" + q + json_rbrace(), "a") - 7442, 9)
                                    i
