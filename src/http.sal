import "io/io.sal"
import "io/net.sal"

fn http_bytes_to_str(b: Bytes, i: Int, n: Int, acc: String) -> String ! alloc
    if i >= n
        acc
    else
        http_bytes_to_str(b, i + 1, n, acc + char_to_str(bytes_get_u8(b, i)))

fn http_read_body(fd: Int, max: Int) -> String ! io, alloc
    cap = 4096
    if max < cap
        cap = max
    buf = bytes_new(cap)
    n = read_timeout_fd(fd, bytes_ptr(buf), cap, 5000)
    if n <= 0
        ""
    else
        slice = bytes_new(n)
        _cp = bytes_copy(slice, 0, buf, 0, n)
        http_bytes_to_str(slice, 0, n, "")

fn http_post(port: Int, path: String, body: String) -> String ! io, alloc
    fd = tcp_connect_loopback(port, 5000)
    if fd < 0
        ""
    else
        req = "POST " + path + " HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: application/json\r\nContent-Length: " + int_to_str(str_len(body)) + "\r\nConnection: close\r\n\r\n" + body
        _w = write_str_fd(fd, req)
        out = http_read_body(fd, 65536)
        _c = close_fd(fd)
        out
