# Utilidades comunes: rutas, fecha y tiempo.

import "io/cwd.sal"
import "io/time.sal"
import "salkit/strbuf.sal"

fn cwd_path() -> String ! io, alloc
    getcwd_str()

# Normaliza una ruta absoluta o relativa: colapsa "//", "." y "..".
fn path_norm(p: String) -> String ! alloc
    abs = 0
    if str_len(p) > 0
        if str_char(p, 0) == 47
            abs = 1
    segs = sk_split_char(p, 47)
    stack = vec_new()
    top = 0
    n = sk_sl_len(segs)
    i = 0
    while i < n
        s = sk_sl_get(segs, i)
        if str_len(s) == 0
            i = i + 0
        elsif str_eq(s, ".") != 0
            i = i + 0
        elsif str_eq(s, "..") != 0
            if top > 0
                if str_eq(str_from_int(vec_get(stack, top - 1)), "..") == 0
                    top = top - 1
                else
                    top = path_push(stack, top, s)
            elsif abs == 0
                top = path_push(stack, top, s)
        else
            top = path_push(stack, top, s)
        i = i + 1
    body = ""
    j = 0
    while j < top
        if j > 0
            body = body + "/"
        body = body + str_from_int(vec_get(stack, j))
        j = j + 1
    if abs != 0
        return "/" + body
    if str_len(body) == 0
        return "."
    body

# Apila `s` en la posición lógica `top` y devuelve el nuevo tope.
fn path_push(stack: Int, top: Int, s: String) -> Int
    if top < vec_len(stack)
        x = vec_set(stack, top, str_as_int(s))
    else
        x = vec_push(stack, str_as_int(s))
    top + 1

# Ruta absoluta y normalizada (las relativas parten del directorio actual).
fn path_abs(p: String) -> String ! io, alloc
    if str_len(p) > 0
        if str_char(p, 0) == 47
            return path_norm(p)
    path_norm(cwd_path() + "/" + p)

# Ruta relativa a `root` si cuelga de él; si no, la misma ruta.
fn path_rel(root: String, p: String) -> String ! alloc
    rl = str_len(root)
    if sk_starts_with(p, root) != 0
        if str_len(p) == rl
            return "."
        if str_char(p, rl) == 47
            return str_slice(p, rl + 1, str_len(p))
        if rl > 0
            if str_char(root, rl - 1) == 47
                return str_slice(p, rl, str_len(p))
    str_slice(p, 0, str_len(p))

fn pad2(n: Int) -> String ! alloc
    if n < 10
        "0" + int_to_str(n)
    else
        int_to_str(n)

# Fecha civil (UTC) AAAA-MM-DD a partir de segundos Unix.
fn date_from_secs(secs: Int) -> String ! alloc
    z = secs / 86400 + 719468
    era = z / 146097
    doe = z - era * 146097
    yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    y = yoe + era * 400
    doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp = (5 * doy + 2) / 153
    d = doy - (153 * mp + 2) / 5 + 1
    m = mp + 3
    if mp >= 10
        m = mp - 9
    if m <= 2
        y = y + 1
    int_to_str(y) + "-" + pad2(m) + "-" + pad2(d)

fn today_str() -> String ! io, alloc
    date_from_secs(clock_realtime_sec())

fn now_ms() -> Int ! io, alloc
    clock_realtime_ms()
