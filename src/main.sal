import "agent_run.sal"
import "tui.sal"
import "io/io.sal"
import "io/process.sal"

fn version_str() -> String
    "supercoder-sal 0.4.1"

fn flag_fmt_json(i: Int, n: Int) -> Int ! alloc
    if i + 1 >= n
        0
    else
        if str_eq(argv(i), "--format") != 0
            if str_eq(argv(i + 1), "json") != 0
                1
            else
                flag_fmt_json(i + 1, n)
        else
            flag_fmt_json(i + 1, n)

fn flag_continue(i: Int, n: Int) -> Int ! alloc
    if i >= n
        0
    else
        if str_eq(argv(i), "--continue") != 0
            1
        else
            flag_continue(i + 1, n)

fn flag_max_turns(i: Int, n: Int) -> Int ! alloc
    if i + 1 >= n
        40
    else
        if str_eq(argv(i), "--max-turns") != 0
            str_as_int(argv(i + 1))
        else
            flag_max_turns(i + 1, n)

fn flag_model(i: Int, n: Int) -> String ! alloc
    if i + 1 >= n
        ""
    else
        a = argv(i)
        if str_eq(a, "--model") != 0
            argv(i + 1)
        else
            if str_eq(a, "-m") != 0
                argv(i + 1)
            else
                flag_model(i + 1, n)

fn scan_session(i: Int, n: Int) -> String ! alloc
    if i >= n
        "default"
    else
        if str_eq(argv(i), "--session") != 0
            if i + 1 < n
                argv(i + 1)
            else
                "default"
        else
            scan_session(i + 1, n)

fn last_arg_prompt(n: Int) -> String ! alloc
    if n < 3
        "hello"
    else
        last = argv(n - 1)
        if str_eq(last, "json") != 0
            "hello"
        else
            if str_contains(last, "--") != 0
                "hello"
            else
                last

fn main() -> Int ! io, alloc
    if argc() < 2
        tui_loop()
    else
        a1 = argv(1)
        if str_eq(a1, "--version") != 0
            _v = write_str_fd(1, version_str() + "\n")
            0
        else
            if str_eq(a1, "run") != 0
                n = argc()
                fmt = flag_fmt_json(2, n)
                cont = flag_continue(2, n)
                max_turns = flag_max_turns(2, n)
                model = flag_model(2, n)
                sid = scan_session(2, n)
                prompt = last_arg_prompt(n)
                run_once(prompt, fmt, max_turns, sid, cont, model)
            else
                if str_eq(a1, "reinstalar") != 0
                    _s = spawn_io_full("/bin/soso-pkg", 0, 1, 2, -1)
                    0
                else
                    _h = write_str_fd(2, "uso: supercoder run [--format json] [--session ID] [--continue] [--max-turns N] [--model MODELO] PROMPT\n")
                    2
