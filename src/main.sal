import "io/io.sal"
import "salkit/strbuf.sal"
import "salkit/int.sal"
import "src/agent/run.sal"
import "src/agents.sal"
import "src/session.sal"
import "src/tui.sal"

fn version_str() -> String
    "supercoder-sal 0.5.0"

fn usage() -> String ! alloc
    "uso: supercoder run [--format json] [--session ID] [--continue] [--max-turns N] [--model MODELO] [--agent NOMBRE] [--interactive] [--yes] [--file RUTA]... PROMPT" + char_to_str(10) + "     supercoder session list" + char_to_str(10) + "     supercoder agents" + char_to_str(10) + "     supercoder --version"

# 1 si `a` es una opción que lleva valor.
fn flag_takes_value(a: String) -> Int
    if str_eq(a, "--format") != 0
        return 1
    if str_eq(a, "--session") != 0
        return 1
    if str_eq(a, "--max-turns") != 0
        return 1
    if str_eq(a, "--model") != 0
        return 1
    if str_eq(a, "-m") != 0
        return 1
    if str_eq(a, "--agent") != 0
        return 1
    if str_eq(a, "--depth") != 0
        return 1
    if str_eq(a, "--file") != 0
        return 1
    0

# Valor de una opción con valor (la última aparición gana); `dflt` si no aparece.
fn opt_value(n: Int, name: String, alias: String, dflt: String) -> String ! alloc
    result = str_slice(dflt, 0, str_len(dflt))
    i = 2
    while i + 1 < n
        a = argv(i)
        if str_eq(a, name) != 0
            result = argv(i + 1)
        elsif str_eq(a, alias) != 0
            result = argv(i + 1)
        i = i + 1
    result

# Valores de todas las apariciones de una opción, separados por saltos de línea.
fn opt_values(n: Int, name: String) -> String ! alloc
    out = ""
    i = 2
    while i + 1 < n
        if str_eq(argv(i), name) != 0
            out = out + argv(i + 1) + char_to_str(10)
        i = i + 1
    out

fn opt_flag(n: Int, name: String) -> Int ! alloc
    i = 2
    while i < n
        if str_eq(argv(i), name) != 0
            return 1
        i = i + 1
    0

# Prompt: argumentos posicionales unidos por espacios (todo lo que sigue a "--" también).
fn positional_prompt(n: Int) -> String ! alloc
    parts = sk_sl_new()
    after = 0
    i = 2
    while i < n
        a = argv(i)
        if after != 0
            x = sk_sl_push(parts, a)
        elsif str_eq(a, "--") != 0
            after = 1
        elsif flag_takes_value(a) != 0
            i = i + 1
        elsif sk_starts_with(a, "-") != 0
            i = i + 0
        else
            x = sk_sl_push(parts, a)
        i = i + 1
    sk_join(parts, " ")

fn cmd_run() -> Int ! io, alloc
    n = argc()
    prompt = positional_prompt(n)
    if str_len(sk_trim(prompt)) == 0
        w = write_str_fd(2, usage() + char_to_str(10))
        return 2
    out_mode = 0
    if str_eq(opt_value(n, "--format", "--format", "text"), "json") != 0
        out_mode = 1
    max_turns = sk_parse_int(opt_value(n, "--max-turns", "--max-turns", "60"))
    if max_turns < 1
        max_turns = 60
    run_agent(prompt, out_mode, max_turns, opt_value(n, "--session", "--session", "default"), opt_flag(n, "--continue"), opt_value(n, "--model", "-m", ""), opt_value(n, "--agent", "--agent", "build"), opt_flag(n, "--interactive"), opt_flag(n, "--yes"), sk_parse_int(opt_value(n, "--depth", "--depth", "0")), opt_values(n, "--file"))

fn cmd_session() -> Int ! io, alloc
    if argc() >= 3
        if str_eq(argv(2), "list") != 0
            ids = session_list()
            i = 0
            while i < sk_sl_len(ids)
                w = write_str_fd(1, sk_sl_get(ids, i) + char_to_str(10))
                i = i + 1
            return 0
    w = write_str_fd(2, usage() + char_to_str(10))
    2

fn main() -> Int ! io, alloc
    if argc() < 2
        return tui_loop()
    a1 = argv(1)
    if str_eq(a1, "--version") != 0
        w = write_str_fd(1, version_str() + char_to_str(10))
        return 0
    if str_eq(a1, "run") != 0
        return cmd_run()
    if str_eq(a1, "session") != 0
        return cmd_session()
    if str_eq(a1, "agents") != 0
        w = write_str_fd(1, agents_describe(0) + char_to_str(10))
        return 0
    w = write_str_fd(2, usage() + char_to_str(10))
    2
