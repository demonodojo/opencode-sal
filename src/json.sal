import "strutil.sal"

fn chat_completion_body(model: String, system: String, user: String) -> String ! alloc
    q = json_quote_char()
    lb = json_lbrace()
    rb = json_rbrace()
    lbr = json_lbracket()
    rbr = json_rbracket()
    sys_part = ""
    if str_len(system) > 0
        sys_part = lbr + lb + q + "role" + q + ":" + q + "system" + q + "," + q + "content" + q + ":" + q + json_esc_content(system) + q + rb + ","
    lb + q + "model" + q + ":" + q + model + q + "," + q + "stream" + q + ":false," + q + "messages" + q + ":" + lbr + sys_part + lb + q + "role" + q + ":" + q + "user" + q + "," + q + "content" + q + ":" + q + json_esc_content(user) + q + rb + rbr + rb

fn followup_tool_body(model: String, prior: String, tool_name: String, tool_out: String) -> String ! alloc
    q = json_quote_char()
    lb = json_lbrace()
    rb = json_rbrace()
    note = "Tool " + tool_name + " returned: " + tool_out
    lb + q + "model" + q + ":" + q + model + q + "," + q + "stream" + q + ":false," + q + "messages" + q + ":" + json_lbracket() + lb + q + "role" + q + ":" + q + "user" + q + "," + q + "content" + q + ":" + q + prior + q + rb + "," + lb + q + "role" + q + ":" + q + "user" + q + "," + q + "content" + q + ":" + q + note + q + rb + json_rbracket() + rb
