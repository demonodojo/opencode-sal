# Herramienta edit: sustituye texto exacto en un fichero.
# Si el texto exacto no aparece, intenta casar línea a línea ignorando la sangría.

import "salkit/fsx.sal"
import "salkit/strbuf.sal"
import "src/tools/common.sal"
import "src/tools/read.sal"
import "src/util.sal"
import "src/agent/ctx.sal"

# Número de línea (desde 1) de la posición `idx`.
fn line_of(text: &String, idx: Int) -> Int
    n = 0
    i = 0
    while i < idx
        if str_char(text, i) == 10
            n = n + 1
        i = i + 1
    n + 1

# Offsets de inicio de cada línea de `text` (más un último elemento con la longitud).
fn line_starts(text: &String) -> Int ! alloc
    v = vec_new()
    x = vec_push(v, 0)
    n = str_len(text)
    i = 0
    while i < n
        if str_char(text, i) == 10
            x = vec_push(v, i + 1)
        i = i + 1
    x = vec_push(v, n + 1)
    v

fn line_text(text: &String, starts: Int, i: Int) -> String ! alloc
    s = vec_get(starts, i)
    e = vec_get(starts, i + 1) - 1
    if e > str_len(text)
        e = str_len(text)
    if e < s
        e = s
    str_slice(text, s, e)

# Busca `old` línea a línea ignorando espacios al inicio y final de cada línea.
# Devuelve un vec [coincidencias, inicio (offset), fin (offset)] de la primera.
fn find_trimmed(text: &String, old: &String) -> Int ! alloc
    r = vec_new()
    olines = sk_split_lines(&old)
    m = sk_sl_len(&olines)
    found = 0
    fs = 0
    fe = 0
    if m > 0
        starts = line_starts(&text)
        total = vec_len(starts) - 1
        i = 0
        while i + m <= total
            ok = 1
            j = 0
            while j < m
                if ok != 0
                    a = sk_trim(&line_text(&text, starts, i + j))
                    b = sk_trim(sk_sl_get(&olines, j))
                    if str_eq(a, b) == 0
                        ok = 0
                j = j + 1
            if ok != 0
                if found == 0
                    fs = vec_get(starts, i)
                    fe = vec_get(starts, i + m) - 1
                    if fe > str_len(text)
                        fe = str_len(text)
                    if fe > fs
                        if str_char(text, fe - 1) == 13
                            fe = fe - 1
                found = found + 1
            i = i + 1
    x = vec_push(r, found)
    x = vec_push(r, fs)
    x = vec_push(r, fe)
    r

# Fragmento numerado del fichero alrededor de la línea `first` (hasta `count` líneas) para que el
# modelo compruebe el resultado sin volver a leer.
fn edit_snippet(text: &String, first: Int, count: Int) -> String ! alloc
    start = first - 2
    if start < 1
        start = 1
    w = read_window(&text, start, count + 4)
    body = w.text
    "<snippet>" + char_to_str(10) + body + "</snippet>"

# Primera línea del texto `old` que tiene contenido (recortada), o "".
fn edit_first_line(old: &String) -> String ! alloc
    lines = sk_split_lines(&old)
    i = 0
    while i < sk_sl_len(&lines)
        t = sk_trim(sk_sl_get(&lines, i))
        if str_len(t) > 0
            return t
        i = i + 1
    ""

# Pista para un oldString que no aparece: dónde está su primera línea, si está.
fn edit_hint(text: &String, old: &String) -> String ! alloc
    first = edit_first_line(&old)
    if str_len(first) == 0
        return ""
    starts = line_starts(&text)
    total = vec_len(starts) - 1
    i = 0
    while i < total
        if str_eq(sk_trim(&line_text(&text, starts, i)), first) != 0
            w = read_window(&text, i + 1, 6)
            body = w.text
            return char_to_str(10) + "The first line of oldString does appear at line " + int_to_str(i + 1) + ", but the following lines differ. Actual text there:" + char_to_str(10) + body
        i = i + 1
    ""

# Sustituye `old` por `new` en `text`. Si `failed` es 1, `text` es el mensaje de error.
struct EditUpdate
    failed: Int
    text: String
    reps: Int
    pos: Int
    trimmed: Int

fn edit_apply(path: &String, text: &String, old: &String, new: &String, all: Int) -> EditUpdate ! alloc
    # Un fichero con finales CRLF: el modelo escribe "\n"; se adapta para que casen y se conserven.
    o = str_slice(old, 0, str_len(old))
    n = str_slice(new, 0, str_len(new))
    if sk_contains(&text, &"\r\n") != 0
        if sk_contains(&o, &"\r") == 0
            o = sk_replace_all(&o, &"\n", &"\r\n")
            if sk_contains(&n, &"\r") == 0
                n = sk_replace_all(&n, &"\n", &"\r\n")
    cnt = sk_count(&text, &o)
    if cnt == 0
        ft = find_trimmed(&text, &o)
        found = vec_get(ft, 0)
        if found == 0
            return EditUpdate(1, "oldString was not found in " + path + ". It must match the file exactly, including whitespace and indentation. Read the file again and copy the text verbatim." + edit_hint(&text, &old), 0, 0, 1)
        if found > 1
            return EditUpdate(1, "oldString matched " + int_to_str(found) + " places when ignoring indentation; add more surrounding lines to make it unique.", 0, 0, 0)
        p1 = vec_get(ft, 1)
        rest = str_slice(text, vec_get(ft, 2), str_len(text))
        return EditUpdate(0, str_slice(text, 0, p1) + n + rest, 1, p1, 1)
    if cnt > 1
        if all == 0
            return EditUpdate(1, "oldString matched " + int_to_str(cnt) + " places in " + path + ". Add more surrounding lines to make it unique, or set replaceAll to true.", 0, 0, 0)
    first = sk_index_of(&text, &o)
    updated = ""
    reps = 1
    if all != 0
        updated = sk_replace_all(&text, &o, &n)
        reps = cnt
    else
        updated = str_slice(text, 0, first) + n + str_slice(text, first + str_len(o), str_len(text))
    EditUpdate(0, updated, reps, first, 0)

fn edit_failed(r: &EditUpdate) -> Int
    r.failed

fn edit_text(r: &EditUpdate) -> String ! alloc
    r.text.dup()

fn tool_edit(c: &Ctx, d: &JsonDoc, a: Int) -> ToolResult ! io, alloc
    raw = arg_str(&d, a, &"filePath,file_path,path,file", "")
    path = path_abs(&raw)
    old = arg_str(&d, a, &"oldString,old_string,oldText,old_text,buscar", "")
    new = arg_str(&d, a, &"newString,new_string,newText,new_text,nuevo", "")
    all = arg_bool(&d, a, &"replaceAll,replace_all,all", 0)
    if str_eq(old, new) != 0
        return tr_err(&"oldString and newString are identical; nothing to change")
    if fsx_exists(&path) == 0
        if str_len(old) == 0
            if fsx_write(&path, &new) != 0
                return tr_err(&("Could not write " + path))
            return tr_ok(&("Created " + path), &path_rel(&cwd_path(), &path))
        return tr_err(&("File not found: " + path))
    if fsx_is_dir(&path) != 0
        return tr_err(&(path + " is a directory"))
    if str_len(old) == 0
        return tr_err(&"oldString must not be empty for an existing file; use write to replace the whole file")
    text = fsx_read_text(&path)
    title = path_rel(&cwd_path(), &path)
    r = edit_apply(&path, &text, &old, &new, all)
    if edit_failed(&r) != 0
        return tr_err(&edit_text(&r))
    updated = edit_text(&r)
    if fsx_write(&path, &updated) != 0
        return tr_err(&("Could not write " + path))
    reps = r.reps
    ln = line_of(&text, r.pos)
    msg = "Edited " + path + " (" + int_to_str(reps) + " replacement" + select_plural(reps) + ", first at line " + int_to_str(ln) + ")"
    if r.trimmed != 0
        msg = "Edited " + path + " (matched ignoring indentation, line " + int_to_str(ln) + ")"
    n_new = sk_count_lines(&new)
    if n_new < 1
        n_new = 1
    if n_new > 12
        n_new = 12
    tr_ok(&(msg + char_to_str(10) + edit_snippet(&updated, ln, n_new)), &title)

# multiedit: varias sustituciones en un mismo fichero, en orden; si una falla no se escribe nada.
fn tool_multiedit(c: &Ctx, d: &JsonDoc, a: Int) -> ToolResult ! io, alloc
    raw = arg_str(&d, a, &"filePath,file_path,path,file", "")
    path = path_abs(&raw)
    en = arg_node(&d, a, &"edits")
    if en < 0
        return tr_err(&"Missing required parameter 'edits'")
    if json_is_array(&d, en) == 0
        return tr_err(&"'edits' must be an array of objects with oldString, newString and optionally replaceAll")
    if fsx_is_file(&path) == 0
        return tr_err(&("File not found: " + path))
    text = fsx_read_text(&path)
    cur = str_slice(text, 0, str_len(text))
    k = 0
    n = json_first(&d, en)
    if n < 0
        return tr_err(&"'edits' is empty")
    summary = sk_sl_new()
    while n >= 0
        k = k + 1
        old = arg_str(&d, n, &"oldString,old_string,oldText,old_text", "")
        new = arg_str(&d, n, &"newString,new_string,newText,new_text", "")
        all = arg_bool(&d, n, &"replaceAll,replace_all,all", 0)
        if str_len(old) == 0
            return tr_err(&("Edit " + int_to_str(k) + ": oldString must not be empty. Nothing was changed."))
        if str_eq(old, new) != 0
            return tr_err(&("Edit " + int_to_str(k) + ": oldString and newString are identical. Nothing was changed."))
        r = edit_apply(&path, &cur, &old, &new, all)
        if edit_failed(&r) != 0
            return tr_err(&("Edit " + int_to_str(k) + " failed: " + edit_text(&r) + char_to_str(10) + "Nothing was changed; fix this edit and send all of them again."))
        x = sk_sl_push(&mut summary, "edit " + int_to_str(k) + ": " + int_to_str(r.reps) + " replacement" + select_plural(r.reps) + " at line " + int_to_str(line_of(&cur, r.pos)))
        cur = edit_text(&r)
        n = json_next(&d, n)
    if fsx_write(&path, &cur) != 0
        return tr_err(&("Could not write " + path))
    tr_ok(&("Applied " + int_to_str(k) + " edits to " + path + char_to_str(10) + sk_join(&summary, &char_to_str(10))), &path_rel(&cwd_path(), &path))

fn select_plural(n: Int) -> String
    if n == 1
        ""
    else
        "s"
