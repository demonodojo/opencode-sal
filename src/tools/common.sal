# Base común de las herramientas: resultados y acceso tolerante a los argumentos.
#
# Un resultado es un struct: estado (0 ok, 1 error), salida y título.

import "salkit/json.sal"
import "salkit/strbuf.sal"
import "salkit/fsx.sal"

struct ToolResult
    failed: Int
    output: String
    title: String

fn tr_new(failed: Int, output: &String, title: &String) -> ToolResult ! alloc
    ToolResult(failed, output.dup(), title.dup())

fn tr_ok(output: &String, title: &String) -> ToolResult ! alloc
    tr_new(0, &output, &title)

fn tr_err(msg: &String) -> ToolResult ! alloc
    tr_new(1, &msg, &"error")

fn tr_failed(r: &ToolResult) -> Int
    r.failed()

fn tr_output(r: &ToolResult) -> String ! alloc
    r.output()

fn tr_title(r: &ToolResult) -> String ! alloc
    r.title()

method ToolResult.failed(&self) -> Int
    self.failed

method ToolResult.output(&self) -> String ! alloc
    self.output.dup()

method ToolResult.title(&self) -> String ! alloc
    self.title.dup()

struct ToolArgs['a]
    doc: &'a JsonDoc
    node: Int

# Primer argumento presente entre los alias "a,b,c"; -1 si no hay ninguno.
fn arg_node(d: &JsonDoc, n: Int, names: &String) -> Int ! alloc
    ToolArgs(d, n).find(names)

method ToolArgs.find(&self, names: &String) -> Int ! alloc
    if json_kind(self.doc, self.node) != 6
        return 0 - 1
    parts = sk_split_char(&names, 44)
    i = 0
    cnt = sk_sl_len(&parts)
    while i < cnt
        k = json_get(self.doc, self.node, sk_sl_get(&parts, i))
        if k >= 0
            return k
        i = i + 1
    0 - 1

fn arg_has(d: &JsonDoc, n: Int, names: &String) -> Int ! alloc
    ToolArgs(d, n).has(names)

method ToolArgs.has(&self, names: &String) -> Int ! alloc
    if self.find(names) >= 0
        1
    else
        0

# Texto del argumento (los números y booleanos se convierten); `dflt` si falta o es null.
fn arg_str(d: &JsonDoc, n: Int, names: &String, dflt: String) -> String ! alloc
    ToolArgs(d, n).string(names, dflt)

method ToolArgs.string(&self, names: &String, dflt: String) -> String ! alloc
    k = self.find(names)
    if k < 0
        return dflt
    kind = json_kind(self.doc, k)
    if kind == 3
        return json_str(self.doc, k).dup()
    if kind == 4
        return json_str(self.doc, k).dup()
    if kind == 2
        return "true"
    if kind == 1
        return "false"
    dflt

fn arg_int(d: &JsonDoc, n: Int, names: &String, dflt: Int) -> Int ! alloc
    ToolArgs(d, n).integer(names, dflt)

method ToolArgs.integer(&self, names: &String, dflt: Int) -> Int ! alloc
    k = self.find(names)
    if k < 0
        return dflt
    kind = json_kind(self.doc, k)
    if kind == 4
        return json_int(self.doc, k)
    if kind == 3
        s = sk_trim(json_str(self.doc, k))
        if sk_is_int(&s) != 0
            return sk_parse_int(&s)
    dflt

fn arg_bool(d: &JsonDoc, n: Int, names: &String, dflt: Int) -> Int ! alloc
    ToolArgs(d, n).boolean(names, dflt)

method ToolArgs.boolean(&self, names: &String, dflt: Int) -> Int ! alloc
    k = self.find(names)
    if k < 0
        return dflt
    kind = json_kind(self.doc, k)
    if kind == 2
        return 1
    if kind == 1
        return 0
    if kind == 3
        s = sk_lower(&sk_trim(json_str(self.doc, k)))
        if str_eq(s, "true") != 0
            return 1
        if str_eq(s, "false") != 0
            return 0
    dflt

# Nombres que las búsquedas recursivas se saltan.
fn default_ignores() -> List[String] ! alloc
    sl = sk_sl_new()
    x = sk_sl_push(&mut sl, ".git")
    x = sk_sl_push(&mut sl, "node_modules")
    x = sk_sl_push(&mut sl, "target")
    x = sk_sl_push(&mut sl, "out")
    x = sk_sl_push(&mut sl, "dist")
    x = sk_sl_push(&mut sl, "__pycache__")
    x = sk_sl_push(&mut sl, ".venv")
    x = sk_sl_push(&mut sl, "venv")
    x = sk_sl_push(&mut sl, "sal_modules")
    x = sk_sl_push(&mut sl, ".cache")
    sl

# 1 si los primeros bytes contienen un NUL (fichero binario).
fn looks_binary(text: &String) -> Int
    n = str_len(text)
    if n > 4096
        n = 4096
    i = 0
    while i < n
        if str_char(text, i) == 0
            return 1
        i = i + 1
    0
