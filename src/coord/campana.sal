import "ejecutor.sal"
import "validar.sal"
import "captura.sal"

fn campana_diez(dir: &String) -> Int ! io, alloc
    captura_base(&dir)
    i = 0
    ok = 0
    while i < 10
        emit_event(&"paso")
        rc = ejecutor_run(&"tarea")
        if rc == 0
            ok = ok + 1
        i = i + 1
    validar_copia(&dir)
    promover_base(&dir)
    if ok >= 5
        0
    else
        1
