# Configuración: supercoder.json (en el directorio de trabajo).
#
# {
#   "model": "soso-coder",
#   "shell": "/bin/sh",
#   "models": {
#     "soso-coder": { "host": "127.0.0.1", "port": 7422, "token_env": "SOSO_LLM_API_KEY",
#                     "max_tokens": 4096, "vision": false, "context_chars": 60000 },
#     "mi-claude":  { "provider": "claude" }
#   }
# }
#
# Un modelo sin entrada usa 127.0.0.1:7422. Sin bloque "models", un ":7442" en el fichero
# selecciona el puerto 7442 (formato antiguo). El asa de configuración es un vec: 0 doc, 1 texto.

import "salkit/json.sal"
import "salkit/fsx.sal"
import "salkit/strbuf.sal"
import "src/provider/claude.sal"

fn cfg_load() -> Int ! io, alloc
    raw = fsx_read_text("supercoder.json")
    d = json_parse("{{}}")
    if str_len(sk_trim(raw)) > 0
        parsed = json_parse(raw)
        if json_ok(parsed) != 0
            if json_is_object(parsed, json_root(parsed)) != 0
                d = parsed
    c = vec_new()
    x = vec_push(c, d)
    x = vec_push(c, str_as_int(raw))
    c

fn cfg_doc(c: Int) -> Int
    vec_get(c, 0)

fn cfg_raw(c: Int) -> String
    str_from_int(vec_get(c, 1))

fn cfg_root(c: Int) -> Int
    json_root(vec_get(c, 0))

# Valor de una clave de primer nivel como texto ("" si falta).
fn cfg_top_str(c: Int, key: String) -> String
    json_get_str(cfg_doc(c), cfg_root(c), key)

# Nodo de la clave de primer nivel, o -1.
fn cfg_top(c: Int, key: String) -> Int
    json_get(cfg_doc(c), cfg_root(c), key)

fn cfg_default_model() -> String
    "soso-coder"

# Prioridad: --model > "model" del fichero > modelo por defecto.
fn cfg_model_for(c: Int, flag: String) -> String ! alloc
    if str_len(flag) > 0
        return str_slice(flag, 0, str_len(flag))
    m = cfg_top_str(c, "model")
    if str_len(m) > 0
        return m
    cfg_default_model()

# Nodo del bloque del modelo en "models", o -1.
fn cfg_mnode(c: Int, model: String) -> Int
    models = cfg_top(c, "models")
    if models < 0
        return 0 - 1
    json_get(cfg_doc(c), models, model)

fn cfg_has_models(c: Int) -> Int
    if cfg_top(c, "models") >= 0
        1
    else
        0

fn cfg_mstr(c: Int, model: String, key: String, dflt: String) -> String ! alloc
    n = cfg_mnode(c, model)
    k = json_get(cfg_doc(c), n, key)
    if k < 0
        return dflt
    if json_kind(cfg_doc(c), k) != 3
        return dflt
    json_str(cfg_doc(c), k)

fn cfg_mint(c: Int, model: String, key: String, dflt: Int) -> Int
    n = cfg_mnode(c, model)
    k = json_get(cfg_doc(c), n, key)
    if k < 0
        return dflt
    json_int(cfg_doc(c), k)

# "claude" si el modelo usa `claude -p`; "openai" si habla HTTP con /v1/chat/completions.
fn cfg_provider(c: Int, model: String) -> String ! alloc
    if claude_has_prefix(model) != 0
        return "claude"
    p = cfg_mstr(c, model, "provider", "")
    if str_eq(p, "claude") != 0
        return "claude"
    "openai"

fn cfg_is_claude(c: Int, model: String) -> Int ! alloc
    if str_eq(cfg_provider(c, model), "claude") != 0
        1
    else
        0

fn cfg_host(c: Int, model: String) -> String ! alloc
    cfg_mstr(c, model, "host", "127.0.0.1")

fn cfg_port(c: Int, model: String) -> Int ! alloc
    p = cfg_mint(c, model, "port", 0)
    if p > 0
        return p
    if cfg_has_models(c) == 0
        if sk_contains(cfg_raw(c), ":7442") != 0
            return 7442
    7422

# Token Bearer: "token" > "token_env" > "token_file" > $SOSO_LLM_API_KEY.
fn cfg_token(c: Int, model: String) -> String ! io, alloc
    t = cfg_mstr(c, model, "token", "")
    if str_len(t) > 0
        return t
    ev = cfg_mstr(c, model, "token_env", "")
    if str_len(ev) > 0
        v = getenv(ev)
        if str_len(v) > 0
            return v
    tf = cfg_mstr(c, model, "token_file", "")
    if str_len(tf) > 0
        content = sk_trim(fsx_read_text(tf))
        if str_len(content) > 0
            return content
    sk_trim(getenv("SOSO_LLM_API_KEY"))

fn cfg_max_tokens(c: Int, model: String) -> Int ! alloc
    cfg_mint(c, model, "max_tokens", 4096)

# Plazo total de una petición al modelo (ms); por defecto 2 h como OpenCode.
fn cfg_timeout_ms(c: Int, model: String) -> Int ! alloc
    cfg_mint(c, model, "timeout_ms", 7200000)

# Presupuesto de caracteres del historial antes de compactar.
fn cfg_context_chars(c: Int, model: String) -> Int ! alloc
    cfg_mint(c, model, "context_chars", 60000)

fn cfg_vision(c: Int, model: String) -> Int ! alloc
    n = cfg_mnode(c, model)
    k = json_get(cfg_doc(c), n, "vision")
    if k < 0
        return 0
    json_bool(cfg_doc(c), k)

fn cfg_shell(c: Int) -> String ! io, alloc
    s = cfg_top_str(c, "shell")
    if str_len(s) > 0
        return s
    if fsx_exists("/bin/sh") != 0
        return "/bin/sh"
    "/bin/sosh"

# 1 si el modelo responde en streaming (SSE): emite eventos text_delta mientras genera.
fn cfg_stream(c: Int, model: String) -> Int ! alloc
    n = cfg_mnode(c, model)
    k = json_get(cfg_doc(c), n, "stream")
    if k < 0
        return 0
    json_bool(cfg_doc(c), k)
