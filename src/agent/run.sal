# Texto plano del historial para el proveedor claude (que no recibe mensajes JSON).
fn history_as_text(msgs: &List[String]) -> String ! alloc
    out = ""
    n = sk_sl_len(msgs)
    i = 0
    while i < n
        d = json_parse(sk_sl_get(msgs, i))
        r = json_root(&d)
        role = json_get_str(&d, r, &"role")
        content = json_get_str(&d, r, &"content")
        if str_len(content) > 0
            if str_eq(role, "user") != 0
                out = out + "User: " + content + char_to_str(10)
            elsif str_eq(role, "assistant") != 0
                out = out + "Assistant: " + content + char_to_str(10)
        i = i + 1
    if str_len(out) > 6000
        out = str_slice(out, str_len(out) - 6000, str_len(out))
    out

# `claude -p` gestiona sus propias herramientas: aquí solo se pasa el prompt y se traducen sus eventos
# (inicio, texto, herramientas, avisos de que sigue en marcha) a los de supercoder.
fn run_claude(c: &mut Ctx, prompt: &String, files: &String) -> Int ! io, alloc
    x = ev_step_start(c)
    ctxt = history_as_text(ctx_msgs(c))
    full = str_slice(prompt, 0, str_len(prompt))
    if str_len(sk_trim(&files)) > 0
        full = full + char_to_str(10) + char_to_str(10) + "Attached files (read them with your Read tool):" + char_to_str(10) + sk_join(&sk_split_lines(&sk_trim(&files)), &char_to_str(10))
    if str_len(ctxt) > 0
        full = "Previous conversation:" + char_to_str(10) + ctxt + char_to_str(10) + "Current request: " + full
    x = osc_working(&c, &"Running claude")
    st = claude_stream(c, &ctx_model(c), &full)
    if cs_launched(&st) == 0
        x = ev_error(&c, &"no se pudo lanzar claude: ¿está instalado y en el PATH?")
        x = osc_error(&c, &"no se pudo lanzar claude")
        y = ev_step_finish(&c, &"error", 0, 0)
        return 1
    claude_finish(c, &st, &prompt)

# Cierra la ejecución de claude: texto final, historial, tokens. 0 si hubo respuesta, 1 si no.
fn claude_finish(c: &mut Ctx, st: &CsState, prompt: &String) -> Int ! io, alloc
    txt = cs_result(st)
    if cs_text(st) == 0
        if str_len(txt) > 0
            x = ev_text(&c, &txt)
    answered = 1
    if str_len(txt) == 0
        if cs_text(st) == 0
            answered = 0
    if cs_failed(st) != 0
        answered = 0
    if answered == 0
        if cs_failed(st) == 0
            y = ev_error(&c, &"claude -p returned no response")
            z0 = osc_error(&c, &"claude -p returned no response")
        elsif str_len(txt) > 0
            y2 = ev_error(&c, &txt)
            z1 = osc_error(&c, &txt)
        z = ev_step_finish(&c, &"error", cs_in(st), cs_out(st))
        return 1
    w = ctx_msgs_mut(c).push(msg_user(&prompt))
    w2 = ctx_msgs_mut(c).push(msg_assistant(&txt, &List.new[Call]()))
    w3 = ev_step_finish(&c, &"stop", cs_in(st), cs_out(st))
    w5 = osc_done(&c, &txt)
    w4 = session_save(&ctx_session(c), ctx_msgs(c))
    0

# Opciones de ejecución: vec [out, max_turns, session, cont, model, agent, interactive, yes].
fn run_agent(prompt: &String, out_mode: Int, max_turns: Int, session_id: &String, cont: Int, model_flag: &String, agent_name: &String, interactive: Int, yes: Int, depth: Int, files: &String, osc_flag: Int) -> Int ! io, alloc
    c = ctx_new()
    cfg = cfg_load()
    x = ctx_set_cfg(&mut c, cfg)
    x = ctx_set_out(&mut c, out_mode)
    x = ctx_set_max_turns(&mut c, max_turns)
    x = ctx_set_session(&mut c, &session_id)
    x = ctx_set_agent(&mut c, &agent_name)
    x = ctx_set_interactive(&mut c, interactive)
    x = ctx_set_yes(&mut c, yes)
    x = ctx_set_osc(&mut c, osc_flag)
    ag = agent_find(&agent_name)
    if ag_found(&ag) == 0
        x = ev_error(&c, &("Unknown agent '" + agent_name + "'. Available agents:" + char_to_str(10) + agents_describe(0)))
        return 2
    x = ctx_set_depth(&mut c, depth)
    x = ctx_set_allow(&mut c, &ag_allow(&ag))
    x = ctx_set_agent_perm(&mut c, &ag_perm(&ag))
    flag = model_flag
    if str_len(flag) == 0
        flag = ag_model(&ag)
    model = cfg_model_for(&cfg, &flag)
    x = ctx_set_model(&mut c, &model)
    x = ctx_set_shell(&mut c, &cfg_shell(&cfg))
    x = ctx_set_vision(&mut c, cfg_vision(&cfg, &model))
    msgs = sk_sl_new()
    if cont != 0
        msgs = session_load(&session_id)
    x = ctx_set_msgs(&mut c, msgs)
    x = perm_grants_load(&mut c)
    x = todos_load(&mut c)
    if cfg_is_claude(&cfg, &model) != 0
        return run_claude(&mut c, &prompt, &files)
    sys = prompt_build(&c, &ag_prompt(&ag))
    x = ctx_set_system(&mut c, &sys)
    defs = tools_defs_depth(&ctx_allow(&c), depth)
    x = ctx_set_tools(&mut c, &defs)
    x = ctx_msgs_mut(&mut c).push(attach_user_message(&mut c, &skill_expand_prompt(&prompt), &files))
    agent_loop(&mut c)

# `supercoder tool NOMBRE JSON`: ejecuta una herramienta sin modelo (depuración y pruebas).
# Escribe la salida por stdout y devuelve 0 si fue bien, 1 si la herramienta falló.
fn run_tool(name: &String, args: &String, yes: Int) -> Int ! io, alloc
    c = ctx_new()
    cfg = cfg_load()
    x = ctx_set_cfg(&mut c, cfg)
    x = ctx_set_out(&mut c, 0)
    x = ctx_set_session(&mut c, &"tool")
    x = ctx_set_agent(&mut c, &"build")
    x = ctx_set_yes(&mut c, yes)
    ag = agent_find(&"build")
    x = ctx_set_allow(&mut c, &ag_allow(&ag))
    x = ctx_set_agent_perm(&mut c, &ag_perm(&ag))
    model = cfg_model_for(&cfg, &"")
    x = ctx_set_model(&mut c, &model)
    x = ctx_set_shell(&mut c, &cfg_shell(&cfg))
    x = ctx_set_vision(&mut c, cfg_vision(&cfg, &model))
    x = ctx_set_msgs(&mut c, sk_sl_new())
    x = perm_grants_load(&mut c)
    x = todos_load(&mut c)
    res = tool_exec(&mut c, &name, &args)
    w = Fd.new(1).write_str(&(tr_output(&res) + char_to_str(10)))
    tr_failed(&res)
