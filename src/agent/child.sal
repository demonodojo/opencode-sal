# Proceso hijo con pipes: stdin/stdout del hijo se leen y escriben por líneas.
# Lo usan la herramienta task (subagentes) y el TUI (cada turno corre en un proceso aparte para que
# la memoria del TUI no crezca con las conversaciones largas).
#
# Asa (vec): 0 pid, 1 lectura de stdout, 2 escritura de stdin, 3 estado [búfer].

import "io/io.sal"
import "io/abi.sal"
import "io/process.sal"
import "io/pipe.sal"
import "io/time.sal"
import "salkit/strbuf.sal"
import "salkit/proc.sal"

# Lanza `bin` con la lista de argumentos `args` (sin argv[0]). Devuelve el asa, o -1 si falla.
fn child_start(bin: &String, args: &List[String]) -> Int ! io, alloc
    argv_l = sk_sl_new()
    sk_sl_push(&mut argv_l, bin.dup())
    i = 0
    while i < sk_sl_len(args)
        sk_sl_push(&mut argv_l, sk_sl_get(args, i).dup())
        i = i + 1
    out_packed = pipe_create_go()
    in_packed = pipe_create_go()
    if out_packed < 0
        return 0 - 1
    if in_packed < 0
        return 0 - 1
    out_pipe = Pipe.from_packed(out_packed)
    in_pipe = Pipe.from_packed(in_packed)
    out_rd = out_pipe.read_fd()
    out_wr = out_pipe.write_fd()
    in_rd = in_pipe.read_fd()
    in_wr = in_pipe.write_fd()
    av = proc_argv_tab(&argv_l)
    pid = spawn_io_argv(bin, argv_l.len(), &av.tab, in_rd, out_wr, 2, &d"", 0 - 1)
    Fd.new(out_wr).close()
    Fd.new(in_rd).close()
    if pid < 0
        Fd.new(out_rd).close()
        Fd.new(in_wr).close()
        return 0 - 1
    st = vec_new()
    vec_push(st, "".to_int())
    h = vec_new()
    x7 = vec_push(h, pid)
    x7 = vec_push(h, out_rd)
    x7 = vec_push(h, in_wr)
    x7 = vec_push(h, st)
    h

# Siguiente línea de stdout del hijo; char 4 al terminar o tras `idle_ms` sin datos.
fn child_read_line(h: Int, idle_ms: Int) -> String ! io, alloc
    child_read_go(h, idle_ms, 0)

# Igual, pero si vence `idle_ms` sin datos devuelve "" en vez de char 4, para distinguir
# "el hijo sigue callado" de "el hijo ha terminado".
fn child_read_line_idle(h: Int, idle_ms: Int) -> String ! io, alloc
    child_read_go(h, idle_ms, 1)

fn child_read_go(h: Int, idle_ms: Int, soft: Int) -> String ! io, alloc
    fd = vec_get(h, 1)
    st = vec_get(h, 3)
    chunk = Bytes.new(65536)
    waited = 0
    result = ""
    done = 0
    while done == 0
        buf = str_from_int(vec_get(st, 0))
        nlp = sk_index_of(&buf, &String.from_char(10))
        if nlp >= 0
            result = buf.slice(0, nlp)
            x = vec_set(st, 0, buf.slice(nlp + 1, buf.len()).to_int())
            done = 1
        else
            k = Fd.new(fd).read_timeout(chunk.ptr(), 65536, 1000)
            if k > 0
                x = vec_set(st, 0, (buf + bytes_view(chunk, 0, k).to_str()).to_int())
                waited = 0
            elsif k == 0
                if buf.len() > 0
                    result = buf
                    x = vec_set(st, 0, "".to_int())
                else
                    result = String.from_char(4)
                done = 1
            else
                waited = waited + 1000
                if waited >= idle_ms
                    if soft != 0
                        result = ""
                    else
                        result = String.from_char(4)
                    done = 1
    result

# Mata al hijo (SIGTERM) para cancelar el turno en marcha.
fn child_kill(h: Int) -> Int ! io
    kill_pid(vec_get(h, 0), 15)

fn child_write_line(h: Int, line: &String) -> Int ! io, alloc
    Fd.new(vec_get(h, 2)).write_str(&(line + String.from_char(10)))

# Cierra los pipes y espera al hijo. Devuelve su código de salida.
fn child_finish(h: Int) -> Int ! io, alloc
    Fd.new(vec_get(h, 2)).close()
    status = wait_pid(vec_get(h, 0))
    Fd.new(vec_get(h, 1)).close()
    Wait.from_raw(status).exit_code()
