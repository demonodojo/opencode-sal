# Captura imágenes del portapapeles en directorios privados por adjunto.
import "io/io.sal"
import "io/process.sal"
import "io/rand.sal"
import "salkit/fsx.sal"
import "salkit/strbuf.sal"
import "src/util.sal"

struct ClipboardImage
    path: String
    error: String

# Los componentes de la ruta son números generados aquí; no se interpola entrada del usuario.
fn clipboard_shell(cmd: &String) -> Int ! io, alloc
    pid = spawn_io_4(&"/bin/sh", &"-c", cmd, &"", SPAWN_FD_CLOSED, SPAWN_FD_CLOSED, SPAWN_FD_CLOSED, 0 - 1)
    if pid < 0
        return 0 - 1
    Wait.from_raw(wait_pid(pid)).exit_code()

fn clipboard_remove(path: &String) -> Int ! io, alloc
    if str_len(path) == 0
        return 0
    # Solo se borran las capturas propias: una imagen adjunta por el usuario (ruta escrita o
    # pegada) se queda donde está.
    if sk_starts_with(path, &"/tmp/supercoder-image-") == 0
        return 0
    _f = fsx_remove(path)
    dir = path_dirname(path)
    clipboard_shell(&("rmdir -- '" + dir + "'"))

fn clipboard_cleanup(paths: &mut List[String]) -> Int ! io, alloc
    while paths.len() > 0
        p = paths.pop()
        _r = clipboard_remove(&p)
    0

fn clipboard_signature(path: &String, ext: &String) -> Int ! io, alloc
    b = fsx_read_bytes_max(path, 12)
    n = b.len()
    if str_eq(ext, "png") != 0
        if n >= 8
            if b.get_u8(0) == 137
                if b.get_u8(1) == 80
                    if b.get_u8(2) == 78
                        if b.get_u8(3) == 71
                            if b.get_u8(4) == 13
                                if b.get_u8(5) == 10
                                    if b.get_u8(6) == 26
                                        if b.get_u8(7) == 10
                                            return 1
    if str_eq(ext, "jpg") != 0
        if n >= 3
            if b.get_u8(0) == 255
                if b.get_u8(1) == 216
                    if b.get_u8(2) == 255
                        return 1
    if str_eq(ext, "gif") != 0
        if n >= 6
            if str_eq(bytes_view(b, 0, 6).to_str(), "GIF87a") != 0
                return 1
            if str_eq(bytes_view(b, 0, 6).to_str(), "GIF89a") != 0
                return 1
    if str_eq(ext, "webp") != 0
        if n >= 12
            if str_eq(bytes_view(b, 0, 4).to_str(), "RIFF") != 0
                if str_eq(bytes_view(b, 8, 12).to_str(), "WEBP") != 0
                    return 1
    0

fn clipboard_capture() -> ClipboardImage ! io, alloc
    dir = "/tmp/supercoder-image-" + int_to_str(getrandom_u64()) + "-" + int_to_str(now_ms())
    if clipboard_shell(&("umask 077; mkdir -- '" + dir + "'")) != 0
        return ClipboardImage("", "No se pudo crear un directorio temporal privado")
    types = sk_split_char(&"png,jpg,gif,webp", 44)
    i = 0
    while i < types.len()
        ext = types.get(i)
        mime = "image/" + ext
        if str_eq(ext, "jpg") != 0
            mime = "image/jpeg"
        path = dir + "/image." + ext
        # ulimit limita la salida de un portapapeles demasiado grande, antes de leerla.
        cmd = "ulimit -f 10242; if [ -n \"$WAYLAND_DISPLAY\" ] && command -v wl-paste >/dev/null 2>&1; then wl-paste --type '" + mime + "' > '" + path + "' 2>/dev/null; elif [ -n \"$DISPLAY\" ] && command -v xclip >/dev/null 2>&1; then xclip -selection clipboard -t '" + mime + "' -o > '" + path + "' 2>/dev/null; else exit 1; fi"
        rc = clipboard_shell(&cmd)
        size = fsx_size(&path)
        if rc == 0
            if size > 0
                if size <= 5242880
                    if clipboard_signature(&path, ext) != 0
                        return ClipboardImage(path, "")
        _r = fsx_remove(&path)
        if size > 5242880
            _d = clipboard_shell(&("rmdir -- '" + dir + "'"))
            return ClipboardImage("", "La imagen supera el límite de 5 MB")
        i = i + 1
    _d = clipboard_shell(&("rmdir -- '" + dir + "'"))
    ClipboardImage("", "No hay una imagen en el portapapeles; escribe o pega su ruta y pulsa Intro, o usa @ruta")
