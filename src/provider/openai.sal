# Proveedor HTTP compatible con OpenAI (soso-llm, llama.cpp...): POST /v1/chat/completions.
#
# La respuesta analizada es un struct PrResp (texto, llamadas, tokens, fin, error y estado).

import "salkit/json.sal"
import "salkit/http.sal"
import "salkit/strbuf.sal"
import "src/agent/ctx.sal"
import "src/agent/messages.sal"
import "src/config.sal"
import "src/events.sal"

struct PrResp
    ok: Int
    text: String
    calls: List[Call]
    inp: Int
    out: Int
    finish: String
    err: String
    status: Int

fn pr_ok(r: &PrResp) -> Int
    r.ok

fn pr_text(r: &PrResp) -> String ! alloc
    r.text.dup()

fn pr_calls(r: &PrResp) -> &List[Call]
    &r.calls

fn pr_in(r: &PrResp) -> Int
    r.inp

fn pr_out(r: &PrResp) -> Int
    r.out

fn pr_finish(r: &PrResp) -> String ! alloc
    r.finish.dup()

fn pr_error(r: &PrResp) -> String ! alloc
    r.err.dup()

fn pr_status(r: &PrResp) -> Int
    r.status

fn pr_new(ok: Int, text: &String, calls: List[Call], inp: Int, out: Int, finish: &String, err: &String, status: Int) -> PrResp ! alloc
    PrResp(ok, text.dup(), calls, inp, out, finish.dup(), err.dup(), status)

fn pr_fail(msg: &String, status: Int) -> PrResp ! alloc
    pr_new(0, &"", List.new[Call](), 0, 0, &"error", &msg, status)

# Cuerpo de la petición: sistema + historial + herramientas.
fn oai_body(c: &Ctx, msgs: &List[String]) -> String ! alloc
    oai_body_mode(c, &msgs, 0)

fn oai_body_mode(c: &Ctx, msgs: &List[String], stream: Int) -> String ! alloc
    model = ctx_model(c)
    items = sk_sl_new()
    if str_len(ctx_system(c)) > 0
        x = sk_sl_push(&mut items, msg_system(&ctx_system(c)))
    n = sk_sl_len(msgs)
    i = 0
    while i < n
        x = sk_sl_push(&mut items, sk_sl_get(msgs, i).dup())
        i = i + 1
    body = jb_kv(&"model", &json_quote(&cfg_wire_model(ctx_cfg(c), &model))) + "," + jb_kv(&"stream", &bool_text(stream)) + "," + jb_kv(&"max_tokens", &int_to_str(cfg_max_tokens(ctx_cfg(c), &model))) + "," + jb_kv(&"messages", &jb_arr(&jb_join(&items)))
    if stream != 0
        body = body + "," + jb_kv(&"stream_options", &jb_obj(&jb_kv(&"include_usage", &"true")))
    if str_len(ctx_tools(c)) > 2
        body = body + "," + jb_kv(&"tools", &ctx_tools(c)) + "," + jb_kv(&"tool_choice", &json_quote(&"auto"))
    jb_obj(&body)

fn bool_text(v: Int) -> String
    if v != 0
        "true"
    else
        "false"

# Texto de una respuesta de error (error.message, o el principio del cuerpo).
fn oai_error_text(body: &String) -> String ! alloc
    d = json_parse(&body)
    if json_ok(&d) != 0
        r = json_root(&d)
        m = json_path(&d, r, &"error.message")
        if m >= 0
            return json_str(&d, m).dup()
        m2 = json_get(&d, r, &"message")
        if m2 >= 0
            return json_str(&d, m2).dup()
    sk_truncate_middle(&sk_trim(&body), 500)

fn oai_parse_calls(d: &JsonDoc, tcs: Int) -> List[Call] ! alloc
    calls = List.new[Call]()
    n = json_first(&d, tcs)
    k = 0
    while n >= 0
        k = k + 1
        fnode = json_get(&d, n, &"function")
        name = json_get_str(&d, fnode, &"name")
        an = json_get(&d, fnode, &"arguments")
        args = "{}"
        if an >= 0
            if json_is_string(&d, an) != 0
                args = json_str(&d, an).dup()
            else
                args = json_dump(&d, an)
        id = json_get_str(&d, n, &"id")
        if str_len(id) == 0
            id = "call_" + int_to_str(k)
        x = calls.push(call_new(&id, &name, &args))
        n = json_next(&d, n)
    calls

# Algunos servidores OpenAI compatibles separan el análisis del contenido final.
fn oai_text_field(d: &JsonDoc, node: Int, key: &String) -> String ! alloc
    n = json_get(d, node, &key)
    if n >= 0
        if json_is_string(d, n) != 0
            return json_str(d, n).dup()
    ""

fn oai_reasoning(d: &JsonDoc, node: Int) -> String ! alloc
    s = oai_text_field(d, node, &"reasoning_content")
    if str_len(s) > 0
        return s
    s = oai_text_field(d, node, &"reasoning")
    if str_len(s) > 0
        return s
    oai_text_field(d, node, &"thinking")

fn oai_message_text(d: &JsonDoc, node: Int) -> String ! alloc
    content = oai_text_field(d, node, &"content")
    thinking = oai_reasoning(d, node)
    if str_len(thinking) <= 0
        return content
    if sk_contains(&content, &"<think>") != 0
        return content
    prefix = "<think>" + char_to_str(10) + thinking + char_to_str(10)
    if sk_contains(&content, &"</think>") != 0
        return prefix + content
    prefix + "</think>" + char_to_str(10) + content

fn oai_parse(status: Int, body: &String) -> PrResp ! alloc
    if status != 200
        return pr_fail(&oai_error_text(&body), status)
    d = json_parse(&body)
    if json_ok(&d) == 0
        return pr_fail(&("invalid JSON from model server: " + sk_truncate_middle(&body, 300)), status)
    root = json_root(&d)
    msg = json_path(&d, root, &"choices.0.message")
    if msg < 0
        return pr_fail(&"response without choices[0].message", status)
    text = oai_message_text(&d, msg)
    calls = List.new[Call]()
    tcs = json_get(&d, msg, &"tool_calls")
    if tcs >= 0
        calls = oai_parse_calls(&d, tcs)
    finish = json_str(&d, json_path(&d, root, &"choices.0.finish_reason")).dup()
    inp = json_int(&d, json_path(&d, root, &"usage.prompt_tokens"))
    out = json_int(&d, json_path(&d, root, &"usage.completion_tokens"))
    pr_new(1, &text, calls, inp, out, &finish, &"", status)

# Una petición sin streaming (también para llamadas auxiliares como resúmenes y descripciones).
# Añade una pista cuando no hay conexión con Ollama (lo habitual: `ollama serve` parado).
fn oai_conn_hint(cfg: &Cfg, model: &String, err: &String) -> String ! io, alloc
    if cfg_is_ollama(&cfg, model) != 0
        return err + " (¿está en marcha `ollama serve`? ¿está descargado el modelo? `ollama pull " + cfg_wire_model(&cfg, model) + "`)"
    if cfg_is_lmstudio(&cfg, model) != 0
        return err + " (¿está activo el servidor local de LM Studio, con el modelo `" + cfg_wire_model(&cfg, model) + "` cargado?)"
    err.dup()

fn oai_chat_plain(c: &Ctx) -> PrResp ! io, alloc
    model = ctx_model(c)
    cfg = ctx_cfg(c)
    body = oai_body(c, ctx_msgs(c))
    r = http_post_json(&cfg_host(&cfg, &model), cfg_port(&cfg, &model), &"/v1/chat/completions", &cfg_token(&cfg, &model), &body, cfg_timeout_ms(&cfg, &model))
    if http_status(&r) == 0
        return pr_fail(&oai_conn_hint(cfg, &model, http_error(&r)), 0)
    oai_parse(http_status(&r), http_body(&r))

# Fragmentos de una llamada indexada en el flujo SSE.
struct StreamCall
    id: String
    name: String
    fragments: List[String]

struct StreamCalls
    items: List[StreamCall]

method StreamCalls.ensure(&mut self, idx: Int) -> Int ! alloc
    while self.items.len() <= idx
        self.items.push(StreamCall(d"", d"", List.new[String]()))
    0

method StreamCalls.add_delta(&mut self, idx: Int, d: &JsonDoc, tc: Int) -> Int ! alloc
    self.ensure(idx)
    item = self.items.get_mut(idx)
    tid = json_get_str(d, tc, &"id")
    if str_len(tid) > 0
        item.id = tid.dup()
    fnode = json_get(d, tc, &"function")
    if fnode >= 0
        fname = json_get_str(d, fnode, &"name")
        if str_len(fname) > 0
            item.name = fname.dup()
        af = json_get(d, fnode, &"arguments")
        if af >= 0
            if json_is_string(d, af) != 0
                item.fragments.push(json_str(d, af).dup())
    0

method StreamCalls.finish(&self) -> List[Call] ! alloc
    calls = List.new[Call]()
    i = 0
    while i < self.items.len()
        item = self.items.get(i)
        if str_len(item.name) > 0
            args = sk_join(&item.fragments, &"")
            if str_len(sk_trim(&args)) == 0
                args = "{}"
            id = item.id.dup()
            if str_len(id) == 0
                id = "call_" + int_to_str(i + 1)
            calls.push(call_new(&id, &item.name, &args))
        i = i + 1
    calls

# Petición con streaming: acumula el texto y las llamadas por índice y emite text_delta.
fn oai_chat_stream(c: &Ctx) -> PrResp ! io, alloc
    model = ctx_model(c)
    cfg = ctx_cfg(c)
    body = oai_body_mode(c, ctx_msgs(c), 1)
    h = hs_open(&cfg_host(&cfg, &model), cfg_port(&cfg, &model), &"/v1/chat/completions", &cfg_token(&cfg, &model), &body, cfg_timeout_ms(&cfg, &model))
    if hs_status(&h) == 0
        return pr_fail(hs_error(&h), 0)
    if hs_status(&h) != 200
        rest = hs_read_rest(&mut h)
        x = hs_close(&mut h)
        return oai_parse(hs_status(&h), &rest)
    parts = sk_sl_new()
    stream_calls = StreamCalls(List.new[StreamCall]())
    finish = ""
    thinking_open = 0
    inp = 0
    out = 0
    go = 1
    while go != 0
        line = hs_next_line(&mut h)
        if str_eq(line, char_to_str(4)) != 0
            go = 0
        elsif sk_starts_with(&line, &"data:") != 0
            payload = sk_trim(&str_slice(line, 5, str_len(line)))
            if str_eq(payload, "[DONE]") != 0
                go = 0
            else
                d = json_parse(&payload)
                if json_ok(&d) != 0
                    r = json_root(&d)
                    delta = json_path(&d, r, &"choices.0.delta")
                    if delta >= 0
                        piece = ""
                        end_thinking = ""
                        thinking = oai_reasoning(&d, delta)
                        if str_len(thinking) > 0
                            if thinking_open == 0
                                piece = "<think>" + char_to_str(10) + thinking
                                thinking_open = 1
                            else
                                piece = thinking
                            parts.push(piece.dup())
                            y = ev_text_delta(c, &piece)
                        content = oai_text_field(&d, delta, &"content")
                        if str_len(content) > 0
                            if thinking_open != 0
                                if sk_contains(&content, &"</think>") == 0
                                    end_thinking = "</think>" + char_to_str(10)
                                    parts.push(end_thinking.dup())
                                    y = ev_text_delta(c, &end_thinking)
                                thinking_open = 0
                            parts.push(content.dup())
                            y = ev_text_delta(c, &content)
                        tcs = json_get(&d, delta, &"tool_calls")
                        if tcs >= 0
                            k = 0
                            tc = json_first(&d, tcs)
                            while tc >= 0
                                idx = k
                                in_node = json_get(&d, tc, &"index")
                                if in_node >= 0
                                    idx = json_int(&d, in_node)
                                z = stream_calls.add_delta(idx, &d, tc)
                                k = k + 1
                                tc = json_next(&d, tc)
                    fr = json_path(&d, r, &"choices.0.finish_reason")
                    if fr >= 0
                        if json_is_string(&d, fr) != 0
                            finish = json_str(&d, fr).dup()
                    un = json_get(&d, r, &"usage")
                    if un >= 0
                        inp = json_get_int(&d, un, &"prompt_tokens")
                        out = json_get_int(&d, un, &"completion_tokens")
    err = hs_error(&h).dup()
    x = hs_close(&mut h)
    if thinking_open != 0
        end_tag = "</think>" + char_to_str(10)
        parts.push(end_tag.dup())
        y = ev_text_delta(c, &end_tag)
    text = sk_join(&parts, &"")
    calls = stream_calls.finish()
    if str_len(text) == 0
        if calls.len() == 0
            if str_len(err) > 0
                return pr_fail(&err, 200)
    pr_new(1, &text, calls, inp, out, &finish, &"", 200)

# Una petición al modelo con el historial actual del contexto (streaming si el modelo lo pide).
fn oai_chat(c: &Ctx) -> PrResp ! io, alloc
    if cfg_stream(ctx_cfg(c), &ctx_model(c)) != 0
        return oai_chat_stream(c)
    oai_chat_plain(c)
